{
  "schema": 1,
  "id": "katamari-android-1.0.0",
  "version": "1",
  "requires_eapx": ">=0.4.4",
  "title": "Katamari Damacy",
  "abi_order": [
    "armeabi"
  ],
  "input": {
    "search_dirs": [
      "gamedata",
      "."
    ]
  },
  "extract": [
    {
      "id": "native-library",
      "description": "Katamari Android ARM native library",
      "destination": "lib/armeabi/libkatamari.so",
      "source": {
        "kind": "entry",
        "patterns": [
          "lib/armeabi/libkatamari.so",
          "katamari/lib/armeabi/libkatamari.so",
          "data/katamari/lib/armeabi/libkatamari.so"
        ]
      },
      "validate": {
        "size": 787547,
        "sha256": [
          "86bbb9a6446c7264c6d333f91c2d5ea9cab62dc551eb581862e188460d17cef7"
        ],
        "elf_machine": "armeabi"
      }
    },
    {
      "id": "assets",
      "description": "Katamari game data from the APK assets directory",
      "destination": "assets",
      "source": {
        "kind": "entries",
        "patterns": [
          "assets/*"
        ],
        "strip_prefix": "assets/"
      },
      "validate": {
        "min_files": 90,
        "min_bytes": 50000000
      }
    },
    {
      "id": "raw-resources",
      "description": "Optional Android raw sound resources",
      "required": false,
      "destination": "res/raw",
      "source": {
        "kind": "entries",
        "patterns": [
          "res/raw/*"
        ],
        "strip_prefix": "res/raw/"
      },
      "validate": {
        "min_files": 1,
        "min_bytes": 1
      }
    }
  ],
  "validate": [
    {
      "path": "lib/armeabi/libkatamari.so",
      "size": 787547,
      "sha256": [
        "86bbb9a6446c7264c6d333f91c2d5ea9cab62dc551eb581862e188460d17cef7"
      ],
      "elf_machine": "armeabi"
    },
    {
      "path": "assets",
      "min_files": 90,
      "min_bytes": 50000000
    }
  ],
  "commit": [
    "lib",
    "assets",
    "res"
  ],
  "marker": ".eapx-katamari-data.json",
  "log": "eapx.log",
  "placeholder": "PUT_KATAMARI_DATA_HERE.txt",
  "space": {
    "safety_bytes": 134217728
  }
}
